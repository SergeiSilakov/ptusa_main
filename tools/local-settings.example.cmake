# Локальные настройки упаковки ACF-приложения (НЕ КОММИТИТЬ).
#
# Скопируйте этот файл в tools/local-settings.cmake и правьте под свою
# машину/объект. Файл tools/local-settings.cmake в .gitignore.
#
# Читается при каждом запуске цели acf_package — менять адрес контроллера
# можно перед запуском, переконфигурировать CMake не нужно.
#
# Приоритет значений: -DHOST/-DKEY (пресет/командная строка) ->
# этот файл -> переменные окружения IOL_HOST/IOL_SSH_KEY/IOL_SSH/IOL_SCP.
# Пустое значение = «взять из следующего источника».

# Адрес контроллера, на котором собирается образ и который получает пакет.
# Здесь и только здесь указывается реальный адрес объекта (файл не в git).
set(IOL_HOST "192.0.2.10")

# Путь к ключу берётся из домашнего каталога пользователя — без личных путей
# в общих файлах.
file(TO_CMAKE_PATH "$ENV{USERPROFILE}" HOME_DIR)
set(IOL_SSH_KEY "${HOME_DIR}/.ssh/axcf.ppk")


# Каталог PLCnext SDK (по умолчанию C:/CLI/sdks/AXCF2000EA/2026.0).
#set(IOL_SDK "C:/CLI/sdks/AXCF2000EA/2026.0")

# Идентификатор приложения, 14 цифр (по умолчанию 10000000000002).
#set(IOL_IDENTIFIER "10000000000002")

# Аргументы запуска в quadlet (по умолчанию main.plua; для отладки -d main.plua).
#set(IOL_EXEC_ARGS "-d main.plua")

